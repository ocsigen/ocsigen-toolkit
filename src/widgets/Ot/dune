(rule
 (with-stdout-to
  dune.corrected
  (run
   ocsigen-dune-rules
   gen-library
   ot
   --wrapped
   true
   --public-name
   ocsigen-toolkit
   --libraries
   calendar
   --preprocess
   lwt_ppx
   --dune
   %{dep:dune})))

; The server library needs the interfaces of js_of_ocaml for the types of
; client values in shared signatures (Dom_html.touchEvent Js.t, File.file
; Js.t...), but must not link it: ocsigenserver loads the library with its
; dependencies, and the module Js of js_of_ocaml fails at initialisation
; outside a browser. So only the include directory is added.

(rule
 (target type_includes)
 (deps (universe))
 (action
  (with-stdout-to
   %{target}
   (system "printf '('; ocamlfind query -i-format js_of_ocaml; printf ')'"))))

(env
 (_
  (flags
   (:standard
    (:include type_includes)))))

; [ocsigen-dune-rules] Do not remove this line.
; Below this line, any changes will be overwritten.
;
; To update the rules below, modify the invocation of ocsigen-dune-rules above
; and run:
;
;     dune runtest --auto-promote
;

(rule
 (alias runtest)
 (action
  (diff dune dune.corrected)))

(library
 (public_name ocsigen-toolkit.server)
 (name ot)
 (modes byte native)
 (wrapped true)
 (library_flags
  (:standard -linkall))
 (preprocess
  (pps
   eliom.ppx.server
   ocsigen-ppx-rpc
   js_of_ocaml-ppx_deriving_json
   --rpc-raw
   lwt_ppx))
 (libraries eliom.server calendar))

(subdir
 client
 (library
  (public_name ocsigen-toolkit.client)
  (name ot)
  (modes byte)
  (wrapped true)
  (library_flags
   (:standard -linkall))
  (libraries eliom.client js_of_ocaml js_of_ocaml-lwt calendar))
 (dynamic_include ../dune.client))

(subdir
 client/ppx
 (rule
  (write-file main.ml "let () = Ppxlib.Driver.standalone ()"))
 (executable
  (name main)
  (libraries
   ppxlib
   eliom.ppx.client
   ocsigen-ppx-rpc
   js_of_ocaml-ppx
   js_of_ocaml-ppx_deriving_json
   lwt_ppx)))

(rule
 (deps
  (glob_files *.eliom)
  (glob_files *.eliomi))
 (action
  (with-stdout-to
   dune.client
   (run
    ocsigen-dune-rules
    gen-client-modules
    --internal-prefix
    ot
    --server-objs-dir
    ../.ot.objs/byte
    .
    --
    --rpc-raw))))
