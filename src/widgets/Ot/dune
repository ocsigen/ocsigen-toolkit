(rule
 (with-stdout-to
  dune.corrected
  (run
   ocsigen-dune-rules
   gen-library
   ot
   --wrapped
   true
   --public-name
   ocsigen-toolkit
   --libraries
   calendar
   --server-libraries
   js_of_ocaml
   --preprocess
   lwt_ppx
   --dune
   %{dep:dune})))

; [ocsigen-dune-rules] Do not remove this line.
; Below this line, any changes will be overwritten.
;
; To update the rules below, modify the invocation of ocsigen-dune-rules above
; and run:
;
;     dune runtest --auto-promote
;

(rule
 (alias runtest)
 (action
  (diff dune dune.corrected)))

(library
 (public_name ocsigen-toolkit.server)
 (name ot)
 (modes byte native)
 (wrapped true)
 (library_flags
  (:standard -linkall))
 (preprocess
  (pps
   eliom.ppx.server
   ocsigen-ppx-rpc
   js_of_ocaml-ppx_deriving_json
   --rpc-raw
   lwt_ppx))
 (libraries eliom.server js_of_ocaml calendar))

(subdir
 client
 (library
  (public_name ocsigen-toolkit.client)
  (name ot)
  (modes byte)
  (wrapped true)
  (library_flags
   (:standard -linkall))
  (libraries eliom.client js_of_ocaml js_of_ocaml-lwt calendar))
 (dynamic_include ../dune.client))

(subdir
 client/ppx
 (rule
  (write-file main.ml "let () = Ppxlib.Driver.standalone ()"))
 (executable
  (name main)
  (libraries
   ppxlib
   eliom.ppx.client
   ocsigen-ppx-rpc
   js_of_ocaml-ppx
   js_of_ocaml-ppx_deriving_json
   lwt_ppx)))

(rule
 (deps
  (glob_files *.eliom)
  (glob_files *.eliomi))
 (action
  (with-stdout-to
   dune.client
   (run
    ocsigen-dune-rules
    gen-client-modules
    --internal-prefix
    ot
    --server-objs-dir
    ../.ot.objs/byte
    .
    --
    --rpc-raw))))
