# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "5.0.0"
synopsis:
  "Reusable UI components for Eliom applications (client only, or client-server)"
description:
  "The Ocsigen Toolkit is a set of user interface widgets that facilitate the development of Eliom applications."
maintainer: ["dev@ocsigen.org"]
authors: ["dev@ocsigen.org"]
license: "LGPL-2.1-only WITH OCaml-LGPL-linking-exception"
homepage: "http://www.ocsigen.org"
bug-reports: "https://github.com/ocsigen/ocsigen-toolkit/issues"
depends: [
  "dune" {>= "3.18"}
  "ocaml" {>= "4.08.0"}
  "js_of_ocaml" {>= "6.4.1"}
  "eliom" {>= "13.0.0" & < "14.0.0"}
  "calendar" {>= "2.0.0"}
  "lwt_ppx"
  "ocsigen-dune-rules" {= "1.0.0"}
  "ocsigen-ppx-rpc" {>= "2.0"}
  "odoc" {with-doc}
]
dev-repo: "git+https://github.com/ocsigen/ocsigen-toolkit.git"
x-maintenance-intent: ["(latest)"]
x-extra-doc-deps: ["ocsigen-start"]

# The default build without "@doc" {with-doc}: the server and client
# libraries define the same modules, so dune's @doc fails with
# "Multiple rules generated". The published docs are built by odoc_driver.
# Keep in sync with the build dune generates by default.
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
  ]
]
